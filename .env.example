# Neon Postgres — pooled connection string, used by the app at runtime.
# Host looks like: ep-xxx-pooler.<region>.aws.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/devstash?sslmode=require"

# Neon Postgres — direct (non-pooled) connection string, used by the Prisma CLI
# for migrations and seeding. Same URL without `-pooler` in the host.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/devstash?sslmode=require"

# Optional: a separate Neon branch/database Prisma uses to detect schema drift.
# Leave unset to let the CLI create a temporary shadow database automatically.
SHADOW_DATABASE_URL=""

# NextAuth v5 — signs and encrypts the session JWT. Generate one with:
#   npx auth secret
AUTH_SECRET=""

# GitHub OAuth app credentials. NextAuth picks these up by name, so the GitHub
# provider needs no explicit options. Create the app at
# https://github.com/settings/developers with the callback URL:
#   http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
